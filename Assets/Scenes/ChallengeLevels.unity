  - {fileID: 8300000, guid: adfb15dfd2db91d4e89880375a428bdc, type: 3}
  - {fileID: 8300000, guid: 6d8bfb815a0911a419741ff91df7e0aa, type: 3}
  - {fileID: 8300000, guid: 09d06360608c2c048b7a7679f2229717, type: 3}
  - {fileID: 8300000, guid: 44aaa43c1de1dc5448a0f1eeb52db650, type: 3}
  subtitles:
  - 'Totem: Back here again?'
  - 'Totem: Come on... you can do better than that.'
  - 'Totem: Oh Idol, I can''t believe you''ve died again.'
  - 'Totem: I''ll pretend I didn''t see you fail...'
  - 'Totem: I''m not mad, just... disappointed.'
  - 'Totem: I''m sure nobody saw that.'
  - 'Totem: Oh... it''s you again.'
  - 'Totem: Such a shame... you were doing surprisingly well.'
  - 'Totem: You''re supposed to go forward, not end up back here.'
  - 'Totem: That was pitiful.'
  - 'Totem: Try again, but with less... failure.'
  - 'Totem: Why are you back here?'
  - 'Totem: You can do better than that.'
  - 'Totem: Go on... you''ve definitely got it this time.'
  cutscene: {fileID: 0}
  cutsceneLength: 0
  voicePlayer: {fileID: 0}
